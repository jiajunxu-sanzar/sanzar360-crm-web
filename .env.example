GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Contacts
GOOGLE_SERVICE_ACCOUNT_JSON=config/credentials/service_account.json

# SMTP por defecto (usuarios sin perfil «jiajun» / «kabir», o fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Los roles de la app (admin, agro_team, sales, employee) NO van aquí:
# los lee la aplicación desde la pestaña «Usuarios CRM» del Google Sheet (columna `rol`).
# Para poder usar la pestaña Email, el usuario debe tener `sales` o `admin`.

# APP_PASSWORD: reservado / no usado por el código actual. Puedes dejarlo vacío o borrarlo.
APP_PASSWORD=

# ── SMTP por usuario: perfiles «jiajun» y «kabir» + rutas por employee_id.
# La parte tras SMTP_ROUTE_BY_EMPLOYEE_ debe ser EXACTAMENTE el employee_id de la fila
# en «Usuarios CRM» (ej. si Kabir es EMP017, usa SMTP_ROUTE_BY_EMPLOYEE_EMP017=kabir).
# Rol «sales» no usa el SMTP global como sustituto si falta ruta o perfil incompleto.
# Equivale a [smtp_profiles.*] y [smtp_route_by_*] en `.streamlit/secrets.toml`.
#
SMTP_PROFILE_JIAJUN_HOST=smtp.gmail.com
SMTP_PROFILE_JIAJUN_PORT=587
SMTP_PROFILE_JIAJUN_USER=
SMTP_PROFILE_JIAJUN_PASSWORD=
SMTP_PROFILE_JIAJUN_USE_TLS=true
#
SMTP_PROFILE_KABIR_HOST=smtp.gmail.com
SMTP_PROFILE_KABIR_PORT=587
SMTP_PROFILE_KABIR_USER=
SMTP_PROFILE_KABIR_PASSWORD=
SMTP_PROFILE_KABIR_USE_TLS=true
#
SMTP_ROUTE_BY_EMPLOYEE_EMP001=jiajun
SMTP_ROUTE_BY_EMPLOYEE_EMP002=kabir
