GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Contacts
GOOGLE_SERVICE_ACCOUNT_JSON=config/credentials/service_account.json

# SMTP por defecto (usuarios sin perfil «jiajun» / «kabir», o fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Los roles de la app (admin, agro_team, sales, employee) NO van aquí:
# los lee la aplicación desde la pestaña «Usuarios CRM» del Google Sheet (columna `rol`).
# Para poder usar la pestaña Email, el usuario debe tener `sales` o `admin`.

# APP_PASSWORD: reservado / no usado por el código actual. Puedes dejarlo vacío o borrarlo.
APP_PASSWORD=

# ── SMTP por usuario: perfiles «jiajun» y «kabir» + rutas por employee_id.
# La parte tras SMTP_ROUTE_BY_EMPLOYEE_ debe ser EXACTAMENTE el employee_id de la fila
# en «Usuarios CRM» (ej. si Kabir es EMP017, usa SMTP_ROUTE_BY_EMPLOYEE_EMP017=kabir).
# Rol «sales» no usa el SMTP global como sustituto si falta ruta o perfil incompleto.
# Equivale a [smtp_profiles.*] y [smtp_route_by_*] en `.streamlit/secrets.toml`.
#
SMTP_PROFILE_JIAJUN_HOST=smtp.gmail.com
SMTP_PROFILE_JIAJUN_PORT=587
SMTP_PROFILE_JIAJUN_USER=
SMTP_PROFILE_JIAJUN_PASSWORD=
SMTP_PROFILE_JIAJUN_USE_TLS=true
#
SMTP_PROFILE_KABIR_HOST=smtp.gmail.com
SMTP_PROFILE_KABIR_PORT=587
SMTP_PROFILE_KABIR_USER=
SMTP_PROFILE_KABIR_PASSWORD=
SMTP_PROFILE_KABIR_USE_TLS=true
#
SMTP_ROUTE_BY_EMPLOYEE_EMP001=jiajun
SMTP_ROUTE_BY_EMPLOYEE_EMP002=kabir

# ── Newsletter (pestaña Email → modo Newsletter) ──────────────────────────
# URL pública donde está desplegada esta app (Streamlit Cloud u otra), SIN
# barra final. Imprescindible para que el botón "Darse de baja" de los
# correos funcione como página de un clic sin login. Si se deja vacía, los
# correos muestran en su lugar un contacto directo a NEWSLETTER_NOTIFY_EMAIL
# y la baja deja de ser automática.
APP_PUBLIC_URL=https://sanzar360-crm-web.streamlit.app/

# A quién llega el aviso cuando alguien se da de baja de la newsletter
# (la baja en sí ya se aplica sola; esto es solo para que quede constancia).
NEWSLETTER_NOTIFY_EMAIL=info@sanzar-group.com

# Secreto para firmar el enlace de baja (evita que se fabrique una URL para
# dar de baja a un contacto arbitrario). Fija un valor propio en producción;
# si se deja vacío se deriva uno de otros secretos ya configurados (menos
# robusto).
NEWSLETTER_UNSUB_SECRET=

# Direcciones precargadas en "Enviarme una prueba" del editor de newsletter
# (separadas por ;). Editable desde la propia app en cada envío de prueba.
NEWSLETTER_TEST_RECIPIENTS=andrei.pop@sanzar-group.com; jiajun.xu@sanzar-group.com; carla.moreno@sanzar-group.com; david.ortiz@sanzar-group.com
